    {"t": 0,   "responder_id": "E1-1", "text": "Command, Engine 1. We're in through the north lobby, taking stairwell A up to three. Smoke is banking down to the second floor.", "expect_tags": ["Status"], "expect_floor": 1, "expect_zone_any": ["stairwell A", "lobby"]},
