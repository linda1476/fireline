    {"t": 28,  "responder_id": "R3-1", "text": "Rescue 3 on five via stairwell B. We've got an occupant up here saying her neighbor in 504 never came out.", "expect_tags": ["VictimFound"], "expect_floor": 5, "expect_zone_any": ["unit 504"], "expect_victim_certainty": "suspected"},
    {"t": 38,  "responder_id": "L2-1", "text": "Ladder 2, we hear someone yelling inside 404, the door is jammed, we need the irons up here.", "expect_tags": ["VictimFound", "HelpNeeded"], "expect_floor": 4, "expect_zone_any": ["unit 404"], "expect_victim_certainty": "suspected"},
    {"t": 48,  "responder_id": "E1-2", "text": "Engine 1-2 to Command, found one victim in 302, adult male, unconscious. We're pulling him out to stairwell A.", "expect_tags": ["VictimFound"], "expect_floor": 3, "expect_zone_any": ["unit 302"], "expect_victim_certainty": "confirmed", "expect_victim_count": 1},
    {"t": 60,  "responder_id": "R3-2", "text": "MAYDAY MAYDAY MAYDAY. Rescue 3-2, fifth floor, stairwell B landing. The ceiling came down, Choi is pinned under it, I can't move him. We need the RIT up here now.", "expect_tags": ["Danger"], "expect_floor": 5, "expect_zone_any": ["stairwell B"], "expect_mayday": true, "expect_priority_min": 5},
    {"t": 72,  "responder_id": "L2-1", "text": "Ladder 2, we forced 404. Two victims, a woman and a child, both responsive. Taking them down — Command, is stairwell B clear? We heard a collapse above us.", "expect_tags": ["VictimFound"], "expect_floor": 4, "expect_zone_any": ["unit 404"], "expect_victim_certainty": "confirmed", "expect_victim_count": 2},
    {"t": 84,  "responder_id": "E1-1", "text": "Engine 1, low air alarm on 1-2. We're backing out down stairwell A with the victim. Send a relief crew to three to hold the line.", "expect_tags": ["Danger", "HelpNeeded"], "expect_floor": 3, "expect_zone_any": ["stairwell A", "east corridor 3"], "expect_needs": true},
    {"t": 96,  "responder_id": "R3-1", "text": "Rescue 3-1 to Command. RIT got the beam off me, I'm okay, I can walk. We're coming down stairwell A, not B. B is blocked at five.", "expect_tags": ["Status"], "expect_floor": 5, "expect_zone_any": ["stairwell B", "stairwell A"], "expect_hazard": true},
    {"t": 108, "responder_id": "L2-1", "text": "Ladder 2 out the north entrance with two victims, handing off to EMS at staging.", "expect_tags": ["Status", "VictimFound"], "expect_floor": 0, "expect_zone_any": ["staging area", "north entrance"], "expect_victim_certainty": "extracted"},
    {"t": 118, "responder_id": "E1-1", "text": "Engine 1 at the lobby, victim handed to EMS. We're going to rehab. 302 is knocked down, but nobody has checked 303 yet.", "expect_tags": ["Status", "VictimFound"], "expect_floor": 1, "expect_zone_any": ["lobby", "unit 303"]}
